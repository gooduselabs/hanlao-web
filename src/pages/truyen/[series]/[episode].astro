---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import YouTubeFacade from '../../../components/YouTubeFacade.astro';
import ReaderToolbar from '../../../components/ReaderToolbar.astro';
import ChapterPills from '../../../components/ChapterPills.astro';
import Thumb from '../../../components/Thumb.astro';
import Icon from '../../../components/Icon.astro';
import { allSeries, episodesOf, readingMinutes, type Episode, type Series } from '../../../lib/episodes';
import { thumbFor, formatDate } from '../../../lib/media';
import { SITE, episodePath, seriesPath, url } from '../../../lib/site';
import '../../../styles/reader.css';

export async function getStaticPaths() {
  const out = [];
  for (const s of await allSeries()) {
    const eps = await episodesOf(s.data.slug);
    eps.forEach((ep, i) =>
      out.push({
        params: { series: s.data.slug, episode: `hoi-${ep.data.episode}` },
        props: { s, ep, prev: eps[i - 1] ?? null, next: eps[i + 1] ?? null, all: eps },
      }),
    );
  }
  return out;
}
interface Props { s: Series; ep: Episode; prev: Episode | null; next: Episode | null; all: Episode[] }
const { s, ep, prev, next, all } = Astro.props;
const d = ep.data;
const { Content, headings } = await render(ep);
const chapters = headings.filter((h) => h.depth === 2);
const minutes = readingMinutes(ep.body);
const title = `Hồi ${d.episode}: ${d.title} — ${d.series}`;
const pageUrl = new URL(episodePath(d.seriesSlug, d.episode), Astro.site).href;
const img = thumbFor(d.seriesSlug, d.episode);
const prevHref = prev ? episodePath(prev.data.seriesSlug, prev.data.episode) : null;
const nextHref = next ? episodePath(next.data.seriesSlug, next.data.episode) : null;
const tocHref = seriesPath(d.seriesSlug) + '#danh-sach';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Chapter',
  name: `Hồi ${d.episode}: ${d.title}`,
  position: d.episode,
  inLanguage: 'vi',
  description: d.summary,
  url: pageUrl,
  author: { '@type': 'Person', name: 'Hàn Lão' },
  ...(img ? { image: new URL(img, Astro.site).href } : {}),
  isPartOf: { '@type': 'Book', name: s.data.fullTitle, url: new URL(seriesPath(d.seriesSlug), Astro.site).href },
  ...(d.youtubeId ? { video: { '@type': 'VideoObject', name: d.ytTitle ?? title, embedUrl: `https://www.youtube.com/embed/${d.youtubeId}`, thumbnailUrl: `https://i.ytimg.com/vi/${d.youtubeId}/hqdefault.jpg`, uploadDate: d.updated, description: d.summary } } : {}),
};
---
<BaseLayout title={title} description={d.summary || s.data.tagline} image={img ?? undefined} type="article" jsonLd={jsonLd} reader bodyClass="reader-page">
  <div class="r-progress" aria-hidden="true"><span></span></div>
  <article
    class="reader"
    data-series={d.seriesSlug}
    data-episode={d.episode}
    data-title={d.title}
    data-url={episodePath(d.seriesSlug, d.episode)}
    data-prev={prevHref ?? ''}
    data-next={nextHref ?? ''}
  >
    <nav class="crumbs" aria-label="Đường dẫn">
      <a href={url('/')}>Trang chủ</a><span class="sep" aria-hidden="true">›</span>
      <a href={seriesPath(d.seriesSlug)}>{s.data.title}</a><span class="sep" aria-hidden="true">›</span>
      <span aria-current="page">Hồi {d.episode}</span>
    </nav>

    <header class="r-head">
      <p class="r-series"><a href={seriesPath(d.seriesSlug)}>{s.data.title}</a></p>
      <h1><span class="r-num">Hồi {d.episode}:</span> {d.title}</h1>
      <p class="r-meta">
        <span>{chapters.length} chương</span><span aria-hidden="true">·</span><span>~{minutes} phút đọc</span>
        {d.updated && <><span aria-hidden="true">·</span><span>Cập nhật {formatDate(d.updated)}</span></>}
      </p>
      <ChapterPills prev={prevHref} next={nextHref} toc={tocHref} where="top" />
      <div class="r-chips" data-reader-ui>
        <button type="button" class="r-chip" data-open="settings"><Icon name="sliders" />Cấu hình</button>
        <button type="button" class="r-chip" data-open="toc"><Icon name="list" />DS chương</button>
        <button type="button" class="r-chip" data-open="scroll"><Icon name="scroll" />Tự cuộn</button>
        <button type="button" class="r-chip" data-open="tts" hidden><Icon name="headphones" />Nghe đọc</button>
      </div>
    </header>

    <section class={`r-media${d.youtubeId || img ? '' : ' no-media'}`} aria-label="Giới thiệu hồi">
      {d.youtubeId ? (
        <YouTubeFacade id={d.youtubeId} title={d.ytTitle ?? title} img={img} />
      ) : img ? (
        <figure class="r-cover"><img src={img} alt={`Ảnh hồi ${d.episode}: ${d.title}`} width="640" height="360" decoding="async" /></figure>
      ) : null}
      <div class="r-summary">
        <p><b>Tóm tắt hồi {d.episode}</b></p>
        {d.summary && <p>{d.summary}</p>}
        {d.youtubeId && <p class="r-listen">▶ Bấm vào ảnh để nghe Hàn Lão kể hồi này (video chỉ tải từ YouTube khi bạn bấm).</p>}
      </div>
    </section>

    <details class="r-inline-toc">
      <summary>Mục lục hồi này ({chapters.length} chương)</summary>
      <ol>{chapters.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </details>

    <div class="r-body" id="r-body">
      <Content />
    </div>

    <p class="r-end" aria-hidden="true">— Hết hồi {d.episode} —</p>

    {next ? (
      <a class="r-next" href={nextHref!}>
        <Thumb series={next.data.seriesSlug} ep={next.data.episode} title={next.data.title} />
        <span>
          <small>Đọc tiếp · Hồi {next.data.episode}</small>
          <b>{next.data.title}</b>
          {next.data.summary && <span class="clamp-2">{next.data.summary}</span>}
        </span>
      </a>
    ) : (
      <div class="r-next is-last">
        <span>
          <small>Hết truyện</small>
          <b>Tàn Đăng Ký đã trọn {all.length} hồi</b>
          <span>
            <a href={tocHref}>Xem lại mục lục</a> · <a href={episodePath(all[0].data.seriesSlug, all[0].data.episode)}>Đọc lại từ Hồi 1</a> · <a href={s.data.youtubeChannel ?? SITE.youtube} target="_blank" rel="noopener">Kênh YouTube</a>
          </span>
        </span>
      </div>
    )}

    <ChapterPills prev={prevHref} next={nextHref} toc={tocHref} where="bottom" />
  </article>

  <ReaderToolbar chapters={chapters.map((h) => ({ id: h.slug, text: h.text }))} episodes={all.map((e) => ({ n: e.data.episode, title: e.data.title, href: episodePath(e.data.seriesSlug, e.data.episode) }))} current={d.episode} seriesTitle={s.data.title} />
</BaseLayout>
