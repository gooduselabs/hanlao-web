---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cover from '../../components/Cover.astro';
import { allSeries, episodesOf } from '../../lib/episodes';
import { SITE, seriesPath, url } from '../../lib/site';
const list = await Promise.all(
  (await allSeries()).map(async (s) => {
    const eps = await episodesOf(s.data.slug);
    return { s, n: eps.length, videos: eps.filter((e) => e.data.youtubeId).length };
  }),
);
---
<BaseLayout title="Danh sách truyện" description="Tất cả truyện tiên hiệp nguyên tác của Hàn Lão.">
  <div class="container">
    <nav class="crumbs" aria-label="Đường dẫn"><a href={url('/')}>Trang chủ</a><span class="sep" aria-hidden="true">›</span><span aria-current="page">Truyện</span></nav>
    <div class="page-title"><h1>Tủ truyện của Hàn Lão</h1><p>Truyện tiên hiệp nguyên tác — chép trọn từng hồi để các con đọc thong thả.</p></div>
    <div class="section" style="padding-top:20px">
      <div class="book-grid">
        {list.map(({ s, n }, i) => (
          <a class="book" href={seriesPath(s.data.slug)}>
            <Cover slug={s.data.slug} title={s.data.title} eager={i < 6} badge={s.data.status} />
            <h3>{s.data.title}</h3>
            <small>{n} hồi · {s.data.genre[0]}</small>
          </a>
        ))}
        <div class="shelf-note">
          <h2>Mỗi hồi một đêm kể chuyện</h2>
          <p>Lão đã chép trọn <b>{list[0].n} hồi</b> của <b>Tàn Đăng Ký</b>; kênh YouTube hiện có bản kể cho {list[0].videos} hồi đầu — theo dõi kênh hoặc RSS để biết khi có thêm bản kể.</p>
          <p class="actions"><a class="btn btn-primary btn-sm" href={SITE.youtube} target="_blank" rel="noopener">Theo dõi kênh</a><a class="btn btn-outline btn-sm" href={url('rss.xml')}>RSS</a></p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
