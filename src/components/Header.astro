---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import YouTubeIcon from './YouTubeIcon.astro';
import SearchBox from './SearchBox.astro';
import { SITE, url } from '../lib/site';
const path = Astro.url.pathname;
const home = url('/');
const links = [
  { href: home, label: 'Trang chủ', icon: 'home', current: path === home },
  { href: url('truyen/'), label: 'Truyện', icon: 'book', current: path.startsWith(url('truyen/')) },
  { href: `${home}#moi-cap-nhat`, label: 'Mới cập nhật', icon: 'clock', current: false },
  { href: url('gioi-thieu/'), label: 'Giới thiệu', icon: 'info', current: path.startsWith(url('gioi-thieu/')) },
] as const;
---
<header class="site-header" data-chrome>
  <div class="container hdr">
    <button class="icon-btn" type="button" data-menu aria-expanded="false" aria-controls="drawer" aria-label="Mở menu">
      <Icon name="menu" />
    </button>
    <Logo />
    <nav class="nav" aria-label="Điều hướng chính">
      {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="hdr-right">
      <SearchBox id="q-desktop" />
      <a class="yt-pill" href={SITE.youtube} target="_blank" rel="noopener">
        <YouTubeIcon /><span>Kênh YouTube</span><span class="sr-only"> (mở tab mới)</span>
      </a>
      <button class="icon-btn" type="button" data-search-toggle aria-expanded="false" aria-controls="m-search" aria-label="Tìm kiếm">
        <Icon name="search" />
      </button>
    </div>
  </div>
  <div class="mobile-search" id="m-search" hidden>
    <div class="container"><SearchBox id="q-mobile" /></div>
  </div>
  <div class="drawer" id="drawer" hidden>
    <nav class="container" aria-label="Menu">
      {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}><Icon name={l.icon} />{l.label}</a>)}
      <a href={SITE.youtube} target="_blank" rel="noopener"><YouTubeIcon class="icon" />Kênh YouTube @hanlaodoctruyen</a>
    </nav>
  </div>
</header>
<script>
  import '../scripts/header.ts';
</script>
