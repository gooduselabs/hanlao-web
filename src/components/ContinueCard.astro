---
const { series = '' } = Astro.props;
---
<a class="continue-card" href="#" data-continue={series}>
  <span aria-hidden="true" style="font-size:1.4rem">🏮</span>
  <span style="flex:1;min-width:0">
    <strong style="display:block;font-size:.8rem;color:var(--jade-deep);letter-spacing:.08em;text-transform:uppercase">Đọc tiếp</strong>
    <span data-continue-title style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:var(--font-serif);font-weight:700"></span>
    <span class="meter" style="display:block;margin-top:6px"><span style="width:0"></span></span>
  </span>
  <span aria-hidden="true">→</span>
</a>
<script>
  import '../scripts/continue.ts';
</script>
