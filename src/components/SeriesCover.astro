---
// Typographic SVG book cover. Palette is derived from the slug so future series differ.
interface Props { title: string; subtitle?: string; slug: string; label?: string }
const { title, subtitle = '', slug, label = 'Hàn Lão kể' } = Astro.props;
const palettes = [
  ['#ffcf8a', '#ff8a5c', '#0e9f8e', '#0a6f66'],
  ['#c9f1ea', '#7fd6c7', '#d99a1e', '#7a2e12'],
  ['#ffe0ec', '#ff9ab5', '#4f7cff', '#23306b'],
];
let h = 0;
for (const c of slug) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const [a, b, c, d] = palettes[h % palettes.length];
const id = `cv-${slug}`;
const words = title.split(' ');
const mid = Math.ceil(words.length / 2);
const lines = words.length > 2 ? [words.slice(0, mid).join(' '), words.slice(mid).join(' ')] : [title];
---
<svg viewBox="0 0 300 420" role="img" aria-label={`Bìa truyện ${title}`}>
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={a} /><stop offset=".6" stop-color={b} /><stop offset="1" stop-color={d} />
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#fff7d6" /><stop offset=".45" stop-color="#ffd166" stop-opacity=".75" /><stop offset="1" stop-color="#ffd166" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="300" height="420" fill={`url(#${id}-bg)`} />
  <circle cx="150" cy="150" r="120" fill={`url(#${id}-glow)`} />
  <path d="M0 300 L60 240 L110 270 L150 200 L190 262 L240 230 L300 280 V420 H0Z" fill={c} opacity=".85" />
  <path d="M0 340 Q80 300 150 330 T300 320 V420 H0Z" fill={d} />
  <g transform="translate(150 150)">
    <rect x="-18" y="-24" width="36" height="46" rx="16" fill="#e8553d" />
    <rect x="-12" y="-28" width="24" height="6" rx="2" fill={d} />
    <rect x="-12" y="20" width="24" height="6" rx="2" fill={d} />
    <ellipse class="flame" cx="0" cy="0" rx="8" ry="11" fill="#ffe7a0" />
  </g>
  <rect x="14" y="14" width="272" height="392" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="1.5" rx="6" />
  <text x="150" y="44" text-anchor="middle" fill="#fff" font-family="Be Vietnam Pro, sans-serif" font-size="12" letter-spacing="4" font-weight="600">{label.toUpperCase()}</text>
  {lines.map((l, i) => (
    <text x="150" y={lines.length > 1 ? 355 + i * 34 - 10 : 368} text-anchor="middle" fill="#fff" font-family="Noto Serif, serif" font-weight="700" font-size={lines.length > 1 ? 30 : 34}>{l}</text>
  ))}
  {subtitle && <text x="150" y="400" text-anchor="middle" fill="#fff" fill-opacity=".9" font-family="Noto Serif, serif" font-style="italic" font-size="13">{subtitle}</text>}
</svg>
