---
// Decorative SVG: sunrise over nine peaks, the Thiên Đăng stone lantern on the summit,
// drifting clouds and a small handmade paper lantern. No people.
---
<svg class="hero-svg" viewBox="0 0 520 520" role="img" aria-labelledby="hero-art-title">
  <title id="hero-art-title">Bình minh trên Cửu Lĩnh, ngọn Thiên Đăng cháy trên đỉnh núi</title>
  <defs>
    <linearGradient id="ha-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd9a8" /><stop offset=".55" stop-color="#ffeccc" /><stop offset="1" stop-color="#e7f8f3" />
    </linearGradient>
    <radialGradient id="ha-sun" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#fff6d8" /><stop offset=".55" stop-color="#ffc56e" /><stop offset="1" stop-color="#ff9a62" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="ha-m1" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5fc9b7" /><stop offset="1" stop-color="#0e9f8e" />
    </linearGradient>
    <linearGradient id="ha-m2" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9fe3d6" /><stop offset="1" stop-color="#4fbfac" />
    </linearGradient>
    <linearGradient id="ha-m3" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0c8a7c" /><stop offset="1" stop-color="#0a6f66" />
    </linearGradient>
    <radialGradient id="ha-glow" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#fff3c4" /><stop offset=".4" stop-color="#ffd166" stop-opacity=".8" /><stop offset="1" stop-color="#ffb347" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="ha-lan" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff8a5c" /><stop offset="1" stop-color="#d9472b" />
    </linearGradient>
    <clipPath id="ha-clip"><circle cx="260" cy="260" r="250" /></clipPath>
  </defs>
  <g clip-path="url(#ha-clip)">
    <rect width="520" height="520" fill="url(#ha-sky)" />
    <circle cx="300" cy="200" r="170" fill="url(#ha-sun)" />
    <circle cx="300" cy="200" r="62" fill="#fff1c9" opacity=".95" />
    <g fill="#ffffff" opacity=".85" class="cloud">
      <ellipse cx="120" cy="150" rx="70" ry="14" /><ellipse cx="150" cy="140" rx="40" ry="14" />
      <ellipse cx="420" cy="120" rx="60" ry="11" /><ellipse cx="400" cy="112" rx="30" ry="10" />
    </g>
    <path d="M0 330 L70 250 L120 290 L190 200 L240 250 L262 150 L290 230 L340 190 L410 270 L470 230 L520 280 V520 H0Z" fill="url(#ha-m2)" opacity=".9" />
    <g>
      <circle cx="262" cy="128" r="46" fill="url(#ha-glow)" class="flame" />
      <rect x="252" y="128" width="20" height="26" rx="3" fill="#7a6a58" />
      <path d="M246 128h32l-6-10h-20z" fill="#5c4f42" />
      <ellipse cx="262" cy="139" rx="6" ry="8" fill="#fff4c2" class="flame" />
    </g>
    <path d="M0 400 L60 330 L130 380 L200 300 L260 360 L330 290 L400 360 L470 320 L520 350 V520 H0Z" fill="url(#ha-m1)" />
    <g fill="#ffffff" opacity=".9" class="cloud" style="animation-duration:18s">
      <ellipse cx="200" cy="350" rx="110" ry="16" /><ellipse cx="380" cy="372" rx="90" ry="13" />
    </g>
    <path d="M0 460 Q130 410 260 450 T520 440 V520 H0Z" fill="url(#ha-m3)" />
    <path d="M0 488 Q140 470 270 486 T520 478 V520 H0Z" fill="#7fd6c7" opacity=".7" />
    <g class="floaty">
      <line x1="110" y1="300" x2="110" y2="330" stroke="#0a6f66" stroke-width="2" />
      <rect x="92" y="330" width="36" height="42" rx="15" fill="url(#ha-lan)" />
      <rect x="98" y="326" width="24" height="6" rx="2" fill="#0a6f66" />
      <rect x="98" y="370" width="24" height="6" rx="2" fill="#0a6f66" />
      <ellipse cx="110" cy="352" rx="8" ry="10" fill="#ffe08a" class="flame" opacity=".9" />
      <line x1="110" y1="376" x2="110" y2="392" stroke="#d99a1e" stroke-width="2" />
    </g>
  </g>
  <circle cx="260" cy="260" r="250" fill="none" stroke="#d99a1e" stroke-opacity=".5" stroke-width="2" />
  <circle cx="260" cy="260" r="258" fill="none" stroke="#0e9f8e" stroke-opacity=".25" stroke-width="1" stroke-dasharray="2 8" />
</svg>
