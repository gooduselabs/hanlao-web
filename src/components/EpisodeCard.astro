---
import type { Episode } from '../lib/episodes';
import { episodePath } from '../lib/site';
interface Props { ep: Episode; showSeries?: boolean }
const { ep, showSeries = false } = Astro.props;
const d = ep.data;
---
<a class="ep-card" href={episodePath(d.seriesSlug, d.episode)} data-progress-key={`${d.seriesSlug}/${d.episode}`}>
  <span class="num">Hồi {d.episode}{showSeries && ` · ${d.series}`}</span>
  <h3>{d.title}</h3>
  {d.summary && <p>{d.summary}</p>}
  <span class="meta">
    {d.chapterCount ? <span class="chip">{d.chapterCount} chương</span> : null}
    {d.youtubeId && <span class="chip red">▶ Có video</span>}
    <span class="chip jade read-mark" hidden>Đã đọc</span>
  </span>
</a>
