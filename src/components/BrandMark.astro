---
const { size = 38, class: cls = 'brand-mark' } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
  <defs>
    <linearGradient id="bm-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffcf6e" /><stop offset="1" stop-color="#f2734f" />
    </linearGradient>
    <radialGradient id="bm-f" cx=".5" cy=".6" r=".5">
      <stop offset="0" stop-color="#fff7d6" /><stop offset=".6" stop-color="#ffd166" /><stop offset="1" stop-color="#f2734f" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="24" cy="24" r="23" fill="#0e9f8e" />
  <path d="M17 13h14l-2 4H19z" fill="#0a6f66" />
  <rect x="15" y="17" width="18" height="18" rx="8" fill="url(#bm-g)" />
  <path d="M24 18v16M19 19c-2 4-2 10 0 14M29 19c2 4 2 10 0 14" stroke="#c4541f" stroke-width="1" fill="none" opacity=".55" />
  <ellipse class="flame" cx="24" cy="26" rx="6" ry="7" fill="url(#bm-f)" />
  <path d="M19 35h10l-2 3h-6z" fill="#0a6f66" />
  <path d="M24 9v4" stroke="#0a6f66" stroke-width="2" stroke-linecap="round" />
</svg>
